# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/job_bot_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM / Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Web Scraping
PROXY_URL=http://proxy-server:port  # Optional: Brightdata residential proxies
CAPTCHA_API_KEY=your-2captcha-api-key

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Streamlit Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME_primaryColor="#0d47a1"

# Job Scraping Configuration
LINKEDIN_SEARCH_QUERY=python developer
LINKEDIN_SEARCH_LOCATION=remote
INDEED_SEARCH_QUERY=backend engineer
REMOTEOK_TAGS=python,remote

# User Profile (for matching engine)
USER_FULL_NAME=Your Name
USER_EMAIL=your.email@example.com
USER_PHONE=+1-XXX-XXX-XXXX
USER_LINKEDIN_URL=https://linkedin.com/in/yourprofile
USER_GITHUB_URL=https://github.com/yourprofile
USER_LOCATION=Remote
USER_EXPERIENCE_YEARS=5

# User Preferences
SALARY_FLOOR=100000
REMOTE_ONLY=True
BLACKLIST_COMPANIES=CompanyA,CompanyB,CompanyC

# Gmail API (for reply detection)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.pickle

# Application Automation
AUTO_APPLY_THRESHOLD=0.75  # Match score threshold for auto-submission
AUTO_APPLY_ENABLED=False  # Start conservatively
MAX_APPLICATIONS_PER_DAY=15
MIN_SECONDS_BETWEEN_SUBMISSIONS=480  # 8 minutes

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_NOTIFICATIONS_ENABLED=False

# S3 / MinIO (for PDF storage)
S3_ENDPOINT_URL=http://localhost:9000  # MinIO in dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=job-bot-resumes
S3_REGION=us-east-1

# Database Migrations
ALEMBIC_CONFIG=alembic.ini

# Feature Flags
ENABLE_LINKEDIN_SCRAPER=True
ENABLE_INDEED_SCRAPER=True
ENABLE_REMOTEOK_SCRAPER=True
ENABLE_LLM_RANKING=True
ENABLE_GMAIL_MONITORING=False
